---
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import rehypeKatex from "rehype-katex";
import remarkMath from "remark-math";
import "katex/dist/katex.min.css";
import Layout from "@/layouts/Layout.astro";
import GlassHeader from "@/components/GlassHeader";
import Footer from "@/components/Footer";
import {
  getInterviewEntries,
  getInterviewSource,
  getInterviewSubtitles,
  htmlExtractOutlineItems,
  interviewParseBlocks,
  interviewSplitAbstractSection,
  interviewSplitReferenceSection,
  markdownAppendReferences,
  markdownUnwrapParagraph,
} from "@/lib/interviews";
import type {
  InterviewBlock,
  InterviewDialogueBlock,
  InterviewEntry,
  InterviewMarkdownBlock,
  InterviewOutlineItem,
  InterviewRelationshipNode,
  InterviewSubtitleCue,
} from "@/lib/interviews";

interface RenderedMarkdownBlock extends InterviewMarkdownBlock {
  html: string;
  outlineHtml: string;
  topicRange?: {
    startTime: number;
    endTime: number;
  };
}

interface RenderedDialogueBlock extends Omit<InterviewDialogueBlock, "markdown" | "note"> {
  contentHtml: string;
  noteHtml?: string;
}

type RenderedBlock = RenderedMarkdownBlock | RenderedDialogueBlock;

interface Props {
  interview: InterviewEntry;
  titleHtml: string;
  introductionHtml: string;
  blocks: RenderedBlock[];
  outlineItems: InterviewOutlineItem[];
  subtitleCues: InterviewSubtitleCue[];
}

function relationshipGraphNodes(nodes: InterviewRelationshipNode[]) {
  const count = nodes.length;

  if (count === 0) {
    return [];
  }

  const radius = count > 10 ? 38 : 34;

  return nodes.map((node, index) => {
    const angle = -Math.PI / 2 + (Math.PI * 2 * index) / count;
    const radiusOffset = count > 10 && index % 2 === 1 ? -4 : 0;
    const nodeRadius = radius + radiusOffset;

    return {
      label: node.label,
      href: node.href,
      x: 50 + Math.cos(angle) * nodeRadius,
      y: 50 + Math.sin(angle) * nodeRadius,
    };
  });
}

function jsonSerializeForScript(value: unknown) {
  return (JSON.stringify(value) ?? "null").replace(/</g, "\\u003c");
}

export async function getStaticPaths() {
  function htmlRemoveTopicPrefix(html: string) {
    return html.replace(/(<h2\b[^>]*>)\s*(?:\d{1,2}[.\s、-]+)([\s\S]*?<\/h2>)/g, "$1$2");
  }

  function markdownBlockStartsTopic(markdown: string) {
    return /^##\s+/m.test(markdown);
  }

  function blockGetTopicRange(blocks: InterviewBlock[], blockIndex: number) {
    const block = blocks[blockIndex];

    if (block.type !== "markdown" || !markdownBlockStartsTopic(block.markdown)) {
      return undefined;
    }

    let startTime: number | undefined;
    let endTime: number | undefined;

    for (let index = blockIndex + 1; index < blocks.length; index += 1) {
      const nextBlock = blocks[index];

      if (nextBlock.type === "markdown" && markdownBlockStartsTopic(nextBlock.markdown)) {
        break;
      }

      if (nextBlock.type !== "dialogue") {
        continue;
      }

      startTime ??= nextBlock.startTime;
      endTime = nextBlock.endTime;
    }

    if (startTime === undefined || endTime === undefined || endTime <= startTime) {
      return undefined;
    }

    return {
      startTime,
      endTime,
    };
  }

  const processor = await createMarkdownProcessor({
    remarkPlugins: [remarkMath],
    rehypePlugins: [rehypeKatex],
  });
  const interviews = await getInterviewEntries();

  return Promise.all(
    interviews.map(async (interview) => {
      const source = await getInterviewSource(interview.slug);
      const subtitleCues = await getInterviewSubtitles(interview.slug);
      const { content, referenceDefinitions } = interviewSplitReferenceSection(source);
      const { content: interviewContent } = interviewSplitAbstractSection(content, interview.name);
      const blocks = interviewParseBlocks(interviewContent, interview.name);
      const renderedTitle = await processor.render(
        markdownAppendReferences(interview.title, referenceDefinitions)
      );
      const renderedIntroduction = interview.introductionMarkdown
        ? await processor.render(
            markdownAppendReferences(interview.introductionMarkdown, referenceDefinitions)
          )
        : null;
      const renderedBlocks = await Promise.all(
        blocks.map(async (block, blockIndex): Promise<RenderedBlock> => {
          if (block.type === "markdown") {
            const rendered = await processor.render(
              markdownAppendReferences(block.markdown, referenceDefinitions)
            );
            return {
              ...block,
              topicRange: blockGetTopicRange(blocks, blockIndex),
              outlineHtml: rendered.code,
              html: htmlRemoveTopicPrefix(rendered.code),
            };
          }

          const rendered = await processor.render(
            markdownAppendReferences(block.markdown, referenceDefinitions)
          );
          const renderedNote = block.note
            ? await processor.render(
                markdownAppendReferences(block.note.markdown, referenceDefinitions)
              )
            : null;
          const { markdown, note, ...dialogueBlock } = block;

          return {
            ...dialogueBlock,
            contentHtml: markdownUnwrapParagraph(rendered.code),
            ...(renderedNote ? { noteHtml: markdownUnwrapParagraph(renderedNote.code) } : {}),
          };
        })
      );
      const outlineItems = renderedBlocks.flatMap((block) =>
        block.type === "markdown" ? htmlExtractOutlineItems(block.outlineHtml) : []
      );

      return {
        params: { slug: interview.slug },
        props: {
          interview,
          titleHtml: markdownUnwrapParagraph(renderedTitle.code),
          introductionHtml: renderedIntroduction?.code.trim() ?? "",
          blocks: renderedBlocks,
          outlineItems,
          subtitleCues,
        },
      };
    })
  );
}

const { interview, titleHtml, introductionHtml, blocks, outlineItems, subtitleCues } = Astro.props as Props;
const summaryGraphNodes = relationshipGraphNodes(interview.relationshipNodes);
const hasSummary = Boolean(introductionHtml || interview.relationshipNodes.length > 0);
const subtitleCuesJson = jsonSerializeForScript(subtitleCues);
---

<Layout title={`${interview.title} - Interviews`} description={interview.title}>
  <GlassHeader client:load />
  <main class="min-h-screen">
    <section class="py-12 md:py-16">
      <div class="container max-w-6xl mx-auto px-6 md:px-4 interview-page">
        <div class="interview-heading">
          <div class="interview-heading-spacer"></div>
          <div class="interview-heading-main">
            <a
              href="/interviews/"
              class="inline-flex items-center text-sm text-muted-foreground hover:text-purple-500 transition-colors mb-4"
            >
              Back to Interviews
            </a>
            <h1 class="interview-title" set:html={titleHtml} />
            <p class="interview-rights-notice">
              版权说明：本页仅为个人学习记录。原始访谈内容的著作权及相关权利归原权利人所有。本站不提供商业使用，不替代原始发布渠道，不主张任何原始内容权利。如涉及权利问题，请联系我处理。
            </p>
          </div>
          <div class="interview-heading-spacer"></div>
        </div>

        <audio data-interview-audio preload="metadata" src={interview.audioHref}></audio>
        <script type="application/json" data-subtitle-cues set:html={subtitleCuesJson}></script>

        <div class="interview-layout">
          <aside class="interview-outline-slot">
            {
              outlineItems.length === 0 ? (
                <div class="interview-outline">
                  <p class="interview-outline-empty">No topics</p>
                </div>
              ) : (
                <div class="interview-outline">
                  <nav class="interview-outline-list" aria-label="Interview topics">
                    {outlineItems.map((item) => (
                      <a
                        href={`#${item.id}`}
                        class:list={[
                          "interview-outline-link",
                          item.depth === 3 && "interview-outline-link--h3",
                        ]}
                        data-outline-link
                      >
                        {item.text}
                      </a>
                    ))}
                  </nav>
                </div>
              )
            }
          </aside>

          <div class="interview-thread">
            {
              hasSummary && (
                <section class="interview-summary" aria-label="Interview summary">
                  {introductionHtml && (
                    <div class="interview-summary-introduction" set:html={introductionHtml} />
                  )}
                  {summaryGraphNodes.length > 0 && (
                    <div
                      class="interview-summary-graph"
                      aria-label={`${interview.relationshipCenter} relationship graph`}
                    >
                      <svg
                        class="interview-summary-graph-lines"
                        viewBox="0 0 100 100"
                        aria-hidden="true"
                        preserveAspectRatio="none"
                      >
                        {summaryGraphNodes.map((node, index) => (
                          <line
                            x1="50"
                            y1="50"
                            x2={node.x}
                            y2={node.y}
                            style={`--line-index: ${index};`}
                          />
                        ))}
                      </svg>
                      {interview.relationshipCenterHref ? (
                        <a
                          class="interview-summary-node interview-summary-node--center"
                          href={interview.relationshipCenterHref}
                          title={interview.relationshipCenter}
                        >
                          {interview.relationshipCenter}
                        </a>
                      ) : (
                        <span class="interview-summary-node interview-summary-node--center">
                          {interview.relationshipCenter}
                        </span>
                      )}
                      {summaryGraphNodes.map((node, index) => (
                        node.href ? (
                          <a
                            class="interview-summary-node"
                            href={node.href}
                            style={`left: ${node.x}%; top: ${node.y}%; --node-index: ${index};`}
                            title={node.label}
                          >
                            {node.label}
                          </a>
                        ) : (
                          <span
                            class="interview-summary-node"
                            style={`left: ${node.x}%; top: ${node.y}%; --node-index: ${index};`}
                            title={node.label}
                          >
                            {node.label}
                          </span>
                        )
                      ))}
                    </div>
                  )}
                </section>
              )
            }
            {
              blocks.map((block) =>
                block.type === "markdown" ? (
                  block.topicRange ? (
                    <section
                      class="interview-topic"
                      data-topic
                      data-topic-start={String(block.topicRange.startTime)}
                      data-topic-end={String(block.topicRange.endTime)}
                    >
                      <div class="interview-markdown interview-topic-markdown" set:html={block.html} />
                    </section>
                  ) : (
                    <div class="interview-markdown" set:html={block.html} />
                  )
                ) : (
                  <article
                    id={block.id}
                    data-dialogue
                    data-start={String(block.startTime)}
                    data-end={String(block.endTime)}
                    class:list={[
                      "interview-message",
                      `interview-message--${block.side}`,
                    ]}
                  >
                    <div class="interview-message-main">
                      <div class="interview-message-row">
                        <div class="interview-message-control">
                          <div class="interview-message-meta">
                            <span>{block.speaker}</span>
                          </div>
                          <button
                            type="button"
                            class="interview-play-button"
                            data-dialogue-play
                            data-start={String(block.startTime)}
                            data-end={String(block.endTime)}
                            aria-label={`Play ${block.speaker} at ${block.timeLabel}`}
                            aria-pressed="false"
                          >
                            <span aria-hidden="true" class="interview-play-icon"></span>
                          </button>
                        </div>
                        <div class="interview-bubble" set:html={block.contentHtml} />
                      </div>
                    </div>
                    {
                      block.noteHtml && (
                        <aside class="interview-message-note" aria-label="Knowledge note">
                          <div class="interview-note-bubble" set:html={block.noteHtml} />
                        </aside>
                      )
                    }
                  </article>
                )
              )
            }
          </div>
        </div>

        <div class="interview-floating-player" data-floating-player hidden>
          <div class="interview-floating-topic">
            <span class="interview-floating-title" data-floating-topic-title></span>
          </div>
          <p class="interview-floating-subtitle" data-floating-subtitle aria-live="polite"></p>
          <div class="interview-floating-controls">
            <button
              type="button"
              class="interview-floating-skip-button"
              data-floating-skip
              data-skip="-15"
              aria-label="后退 15 秒"
            >
              <span aria-hidden="true">-15</span>
            </button>
            <button
              type="button"
              class="interview-floating-play-button"
              data-floating-topic-play
              aria-label="播放当前主题"
              aria-pressed="false"
            >
              <span aria-hidden="true" class="interview-play-icon"></span>
            </button>
            <button
              type="button"
              class="interview-floating-skip-button"
              data-floating-skip
              data-skip="15"
              aria-label="前进 15 秒"
            >
              <span aria-hidden="true">+15</span>
            </button>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer client:load />
</Layout>

<script>
  import { interviewPlayerMount } from "@/lib/interview-player";

  interviewPlayerMount();
</script>

<style is:global>
  .interview-heading {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .interview-page {
    --interview-content-width: 44rem;
    max-width: 86rem;
    padding-bottom: 6rem;
  }

  @media (min-width: 768px) {
    .interview-heading {
      grid-template-columns: 15rem minmax(0, 1fr) 15rem;
    }
  }

  .interview-heading-main {
    justify-self: center;
    min-width: 0;
    width: min(100%, var(--interview-content-width));
  }

  .interview-title {
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1.22;
    margin: 0;
    max-width: 52rem;
    overflow-wrap: anywhere;
  }

  .interview-title a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .interview-layout {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .interview-layout {
      grid-template-columns: 15rem minmax(0, 1fr);
    }
  }

  .interview-outline-slot {
    min-width: 0;
  }

  .interview-outline {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--background) 82%, transparent);
    box-sizing: border-box;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    padding: 0.75rem;
    width: 100%;
  }

  @media (min-width: 768px) {
    .interview-outline {
      max-height: min(90vh, 40rem);
      position: fixed;
      top: calc(50% + 30px);
      transform: translate(3.5rem, -50%);
      width: 14rem;
    }
  }

  .interview-note-bubble {
    background: color-mix(in oklab, var(--color-purple-500) 8%, var(--background));
    border: 1px solid color-mix(in oklab, var(--color-purple-500) 22%, var(--border));
    border-radius: 0.5rem;
    box-sizing: border-box;
    color: var(--foreground);
    font-size: 0.78rem;
    line-height: 1.52;
    overflow-wrap: anywhere;
    padding: 0.62rem 0.75rem;
    width: 100%;
  }

  .interview-note-bubble p {
    margin: 0;
  }

  .interview-note-bubble p + p {
    margin-top: 0.48rem;
  }

  .interview-note-bubble a {
    color: var(--color-purple-500);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .interview-note-bubble img {
    background: color-mix(in oklab, var(--muted) 72%, transparent);
    border: 1px solid color-mix(in oklab, var(--border) 76%, transparent);
    border-radius: 0.42rem;
    display: block;
    height: auto;
    margin: 0.58rem 0 0.38rem;
    max-height: 10rem;
    object-fit: cover;
    width: 100%;
  }

  .interview-note-bubble img:first-child {
    margin-top: 0;
  }

  .interview-note-bubble img:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 767px) {
    .interview-heading-spacer {
      display: none;
    }
  }

  .interview-outline-empty {
    color: var(--muted-foreground);
    font-size: 0.78rem;
  }

  .interview-outline-list {
    display: grid;
    gap: 0.15rem;
  }

  .interview-outline-link {
    border-left: 2px solid transparent;
    color: var(--muted-foreground);
    display: block;
    font-size: 0.74rem;
    line-height: 1.28;
    overflow: hidden;
    padding: 0.18rem 0.3rem 0.18rem 0.55rem;
    text-overflow: ellipsis;
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .interview-outline-link:hover {
    background: color-mix(in oklab, var(--color-purple-500) 8%, transparent);
    border-left-color: color-mix(in oklab, var(--color-purple-500) 65%, transparent);
    color: var(--foreground);
  }

  .interview-outline-link--h3 {
    font-size: 0.7rem;
    padding-left: 1.1rem;
  }

  .interview-thread {
    display: grid;
    gap: 0.68rem;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .interview-thread {
      grid-template-columns: minmax(0, 1fr) 15rem;
    }
  }

  .interview-topic {
    grid-column: 1;
    justify-self: center;
    margin: 2.7rem 0 1.2rem;
    min-width: 0;
    width: min(100%, var(--interview-content-width));
  }

  .interview-markdown.interview-topic-markdown {
    margin: 0;
    min-width: 0;
  }

  .interview-markdown.interview-topic-markdown h2 {
    margin: 0;
  }

  .interview-floating-player {
    backdrop-filter: blur(18px);
    background: color-mix(in oklab, var(--background) 88%, transparent);
    border: 1px solid color-mix(in oklab, var(--border) 82%, transparent);
    border-radius: 0.7rem;
    bottom: 1rem;
    box-shadow: 0 0.9rem 2rem color-mix(in oklab, var(--foreground) 11%, transparent);
    display: grid;
    gap: 0.7rem;
    grid-template-columns: minmax(8rem, 13rem) minmax(0, 1fr) auto;
    left: 50%;
    max-width: calc(100vw - 2rem);
    min-width: 0;
    padding: 0.62rem 0.78rem;
    position: fixed;
    transform: translateX(-50%);
    width: min(38.4rem, calc(100vw - 2rem));
    z-index: 45;
  }

  .interview-floating-player[hidden] {
    display: none;
  }

  .interview-floating-topic {
    align-self: center;
    min-width: 0;
  }

  .interview-floating-title {
    color: var(--foreground);
    display: block;
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.25;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .interview-floating-subtitle {
    align-self: center;
    color: var(--muted-foreground);
    font-size: 0.82rem;
    line-height: 1.25;
    margin: 0;
    min-width: 0;
    overflow: hidden;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .interview-floating-subtitle:empty::before {
    content: " ";
  }

  .interview-floating-controls {
    align-items: center;
    display: flex;
    flex: 0 0 auto;
    gap: 0.38rem;
  }

  .interview-floating-skip-button,
  .interview-floating-play-button {
    align-items: center;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--foreground);
    display: inline-flex;
    flex: 0 0 auto;
    height: 1.58rem;
    justify-content: center;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .interview-floating-skip-button {
    font-size: 0.68rem;
    font-weight: 650;
    min-width: 2.25rem;
    padding: 0 0.42rem;
  }

  .interview-floating-play-button {
    width: 1.58rem;
  }

  .interview-floating-skip-button:hover,
  .interview-floating-play-button:hover,
  .interview-floating-play-button.interview-player-button--active {
    background: color-mix(in oklab, var(--color-purple-500) 12%, var(--background));
    border-color: color-mix(in oklab, var(--color-purple-500) 45%, var(--border));
    color: var(--color-purple-500);
  }

  .interview-floating-skip-button:hover,
  .interview-floating-play-button:hover {
    transform: translateY(-0.05rem);
  }

  .interview-floating-skip-button:disabled,
  .interview-floating-play-button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
    transform: none;
  }

  @media (max-width: 767px) {
    .interview-floating-player {
      gap: 0.45rem;
      grid-template-columns: minmax(5.8rem, 0.8fr) minmax(0, 1fr) auto;
      max-width: calc(100vw - 1rem);
      padding: 0.58rem 0.62rem;
      width: calc(100vw - 1rem);
    }

    .interview-floating-title {
      font-size: 0.78rem;
    }

    .interview-floating-subtitle {
      font-size: 0.76rem;
      text-align: left;
    }
  }

  .interview-summary {
    align-items: center;
    display: grid;
    gap: 1.2rem;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 21rem);
    justify-self: center;
    margin: 0 0 1.2rem;
    padding: 1.1rem 1.25rem;
    width: min(100%, var(--interview-content-width));
  }

  @media (min-width: 768px) {
    .interview-summary {
      grid-column: 1 / -1;
      width: min(100%, calc(var(--interview-content-width) + 1.5rem + 15rem));
    }
  }

  .interview-summary-introduction {
    color: var(--muted-foreground);
    font-size: 0.95rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .interview-summary-introduction > :first-child {
    margin-top: 0;
  }

  .interview-summary-introduction > :last-child {
    margin-bottom: 0;
  }

  .interview-summary-introduction p,
  .interview-summary-introduction ul,
  .interview-summary-introduction ol {
    margin: 0 0 0.8rem;
  }

  .interview-summary-introduction ul,
  .interview-summary-introduction ol {
    padding-left: 1.3rem;
  }

  .interview-summary-introduction ul {
    list-style: disc;
  }

  .interview-summary-introduction ol {
    list-style: decimal;
  }

  .interview-summary-introduction a {
    color: var(--color-purple-500);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .interview-summary-graph {
    display: block;
    height: 14rem;
    min-width: 0;
    overflow: hidden;
    position: relative;
    transform: translateZ(0);
    width: 100%;
  }

  .interview-summary-graph-lines {
    color: color-mix(in oklab, var(--color-purple-500) 42%, var(--muted-foreground));
    height: 100%;
    inset: 0;
    position: absolute;
    width: 100%;
  }

  .interview-summary-graph-lines line {
    animation: interview-summary-line-breathe 4.8s ease-in-out infinite;
    animation-delay: calc(var(--line-index) * -0.28s);
    stroke: currentColor;
    stroke-width: 0.45;
