---
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import Layout from "@/layouts/Layout.astro";
import GlassHeader from "@/components/GlassHeader";
import Footer from "@/components/Footer";
import { getNoteContent, getNoteEntries } from "@/lib/assets";
import type { NoteEntry } from "@/lib/assets";

interface Props {
  note: NoteEntry;
  html: string;
}

export async function getStaticPaths() {
  const processor = await createMarkdownProcessor({});
  const notes = await getNoteEntries();

  return Promise.all(
    notes.map(async (note) => {
      const content = await getNoteContent(note.slug);
      const rendered = await processor.render(content);

      return {
        params: { slug: note.slug },
        props: {
          note,
          html: rendered.code,
        },
      };
    })
  );
}

const { note, html } = Astro.props as Props;
---

<Layout title={`${note.title} - Notes`} description={note.title}>
  <GlassHeader client:load />
  <main class="min-h-screen">
    <section class="py-12 md:py-16">
      <div class="container max-w-4xl mx-auto px-6 md:px-4">
        <div class="mb-8">
          <a
            href="/assets/"
            class="inline-flex items-center text-sm text-muted-foreground hover:text-purple-500 transition-colors mb-4"
          >
            ← Assets
          </a>
          <h1 class="text-4xl font-bold mb-3">{note.title}</h1>
          <a
            href={note.sourceHref}
            class="inline-flex items-center text-sm text-muted-foreground hover:text-purple-500 transition-colors"
          >
            Open source Markdown
          </a>
        </div>

        <article
          class="markdown-note rounded-lg border border-border/50 bg-background/80 backdrop-blur-md backdrop-filter shadow-sm dark:bg-card/30 dark:backdrop-blur-md p-5 md:p-7"
          set:html={html}
        />
      </div>
    </section>
  </main>
  <Footer client:load />
</Layout>

<style is:global>
  .markdown-note {
    color: var(--foreground);
  }

  .markdown-note > :first-child {
    margin-top: 0;
  }

  .markdown-note > :last-child {
    margin-bottom: 0;
  }

  .markdown-note h1,
  .markdown-note h2,
  .markdown-note h3 {
    font-weight: 700;
    margin: 1.5em 0 0.65em;
  }

  .markdown-note h1 {
    font-size: 1.7rem;
    line-height: 1.25;
  }

  .markdown-note h2 {
    font-size: 1.35rem;
    line-height: 1.3;
  }

  .markdown-note h3 {
    font-size: 1.12rem;
    line-height: 1.35;
  }

  .markdown-note p,
  .markdown-note li {
    color: var(--muted-foreground);
    line-height: 1.85;
  }

  .markdown-note p,
  .markdown-note ul,
  .markdown-note ol,
  .markdown-note pre {
    margin: 0 0 1rem;
  }

  .markdown-note ul,
  .markdown-note ol {
    padding-left: 1.4rem;
  }

  .markdown-note ul {
    list-style: disc;
  }

  .markdown-note ol {
    list-style: decimal;
  }

  .markdown-note a {
    color: var(--color-purple-500);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .markdown-note code {
    border-radius: 0.35rem;
    background: color-mix(in oklab, var(--muted) 80%, transparent);
    padding: 0.1rem 0.35rem;
    color: var(--foreground);
  }

  .markdown-note pre {
    overflow-x: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: color-mix(in oklab, var(--muted) 60%, transparent);
    padding: 1rem;
  }

  .markdown-note pre code {
    background: transparent;
    padding: 0;
  }

  .markdown-note blockquote {
    border-left: 3px solid var(--color-purple-500);
    margin: 1rem 0;
    padding-left: 1rem;
    color: var(--muted-foreground);
  }
</style>
