---
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import rehypeKatex from "rehype-katex";
import remarkMath from "remark-math";
import "katex/dist/katex.min.css";
import Layout from "@/layouts/Layout.astro";
import GlassHeader from "@/components/GlassHeader";
import Footer from "@/components/Footer";
import { getNoteContent, getNoteEntries } from "@/lib/assets";
import type { NoteEntry } from "@/lib/assets";

interface Props {
  note: NoteEntry;
  html: string;
  outlineItems: OutlineItem[];
}

interface OutlineItem {
  id: string;
  depth: number;
  text: string;
}

export async function getStaticPaths() {
  function stripHtml(value: string) {
    return value.replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
  }

  function decodeHtml(value: string) {
    return value
      .replace(/&amp;/g, "&")
      .replace(/&lt;/g, "<")
      .replace(/&gt;/g, ">")
      .replace(/&quot;/g, "\"")
      .replace(/&#39;/g, "'");
  }

  function extractOutlineItems(html: string): OutlineItem[] {
    const headings = html.matchAll(/<h([1-3]) id="([^"]+)">([\s\S]*?)<\/h\1>/g);

    return Array.from(headings, (match) => ({
      depth: Number(match[1]),
      id: match[2],
      text: decodeHtml(stripHtml(match[3])),
    }));
  }

  const processor = await createMarkdownProcessor({
    remarkPlugins: [remarkMath],
    rehypePlugins: [rehypeKatex],
  });
  const notes = await getNoteEntries();

  return Promise.all(
    notes.map(async (note) => {
      const content = await getNoteContent(note.slug);
      const rendered = await processor.render(content);

      return {
        params: { slug: note.slug },
        props: {
          note,
          html: rendered.code,
          outlineItems: extractOutlineItems(rendered.code),
        },
      };
    })
  );
}

const { note, html, outlineItems } = Astro.props as Props;
---

<Layout title={`${note.title} - Notes`} description={note.title}>
  <GlassHeader client:load />
  <main class="min-h-screen">
    <section class="py-12 md:py-16">
      <div class="container max-w-6xl mx-auto px-6 md:px-4">
        <div class="mb-8">
          <a
            href="/assets/"
            class="inline-flex items-center text-sm text-muted-foreground hover:text-purple-500 transition-colors"
          >
            Back to Assets
          </a>
        </div>

        <div class="grid gap-6 md:grid-cols-[14rem_minmax(0,1fr)]">
          <aside class="outline-panel md:sticky md:top-24 md:self-start">
            <p class="outline-title">Outline</p>
            {
              outlineItems.length === 0 ? (
                <p class="outline-empty">No headings</p>
              ) : (
                <nav class="outline-list" aria-label="Note outline">
                  {outlineItems.map((item) => (
                    <a
                      href={`#${item.id}`}
                      class:list={[
                        "outline-link",
                        item.depth === 2 && "outline-link--h2",
                        item.depth === 3 && "outline-link--h3",
                      ]}
                      data-outline-link
                    >
                      {item.text}
                    </a>
                  ))}
                </nav>
              )
            }
          </aside>

          <div class="rounded-lg border border-border/50 bg-background/80 backdrop-blur-md backdrop-filter shadow-sm dark:bg-card/30 dark:backdrop-blur-md p-5 md:p-7 min-w-0">
            <article class="markdown-note" set:html={html} />
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer client:load />
</Layout>

<script>
  const outlineLinks = document.querySelectorAll("[data-outline-link]");

  for (const outlineLink of outlineLinks) {
    outlineLink.addEventListener("click", (event) => {
      event.preventDefault();

      const href = outlineLink.getAttribute("href");
      if (!href || !href.startsWith("#")) {
        return;
      }

      const target = document.getElementById(href.slice(1));
      if (!target) {
        return;
      }

      target.scrollIntoView({ behavior: "smooth", block: "start" });
      history.replaceState(history.state, "", href);
    });
  }
</script>

<style is:global>
  .markdown-note {
    color: var(--foreground);
  }

  .markdown-note > :first-child {
    margin-top: 0;
  }

  .markdown-note > :last-child {
    margin-bottom: 0;
  }

  .markdown-note h1,
  .markdown-note h2,
  .markdown-note h3 {
    font-weight: 700;
    margin: 1.5em 0 0.65em;
    scroll-margin-top: 6rem;
  }

  .markdown-note h1 {
    font-size: 1.7rem;
    line-height: 1.25;
  }

  .markdown-note h2 {
    font-size: 1.35rem;
    line-height: 1.3;
  }

  .markdown-note h3 {
    font-size: 1.12rem;
    line-height: 1.35;
  }

  .markdown-note p,
  .markdown-note li {
    color: var(--muted-foreground);
    line-height: 1.85;
  }

  .markdown-note p,
  .markdown-note ul,
  .markdown-note ol,
  .markdown-note pre {
    margin: 0 0 1rem;
  }

  .markdown-note ul,
  .markdown-note ol {
    padding-left: 1.4rem;
  }

  .markdown-note ul {
    list-style: disc;
  }

  .markdown-note ol {
    list-style: decimal;
  }

  .markdown-note a {
    color: var(--color-purple-500);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .markdown-note code {
    border-radius: 0.35rem;
    background: color-mix(in oklab, var(--muted) 80%, transparent);
    padding: 0.1rem 0.35rem;
    color: var(--foreground);
  }

  .markdown-note pre {
    overflow-x: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: color-mix(in oklab, var(--muted) 60%, transparent);
    padding: 1rem;
  }

  .markdown-note pre code {
    background: transparent;
    padding: 0;
  }

  .markdown-note blockquote {
    border-left: 3px solid var(--color-purple-500);
    margin: 1rem 0;
    padding-left: 1rem;
    color: var(--muted-foreground);
  }

  .markdown-note .katex-display {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.35rem 0;
  }

  .outline-panel {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--background) 82%, transparent);
    padding: 0.75rem;
  }

  .outline-title {
    color: var(--foreground);
    font-size: 0.82rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .outline-empty {
    color: var(--muted-foreground);
    font-size: 0.78rem;
  }

  .outline-list {
    display: grid;
    gap: 0.15rem;
  }

  .outline-link {
    border-left: 2px solid transparent;
    color: var(--muted-foreground);
    display: block;
    font-size: 0.78rem;
    line-height: 1.35;
    padding: 0.22rem 0.3rem 0.22rem 0.55rem;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .outline-link:hover {
    background: color-mix(in oklab, var(--color-purple-500) 8%, transparent);
    border-left-color: color-mix(in oklab, var(--color-purple-500) 65%, transparent);
    color: var(--foreground);
  }

  .outline-link--h2 {
    padding-left: 1rem;
  }

  .outline-link--h3 {
    padding-left: 1.45rem;
    font-size: 0.74rem;
  }
</style>
