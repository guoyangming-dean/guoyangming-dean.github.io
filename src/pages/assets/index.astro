---
import Layout from "@/layouts/Layout.astro";
import GlassHeader from "@/components/GlassHeader";
import Footer from "@/components/Footer";
import { getAssetsPageData } from "@/lib/assets";

const { files, pictures, notes, docs } = await getAssetsPageData();

const sections = [
  {
    id: "files",
    title: "Files",
    items: files,
  },
  {
    id: "pictures",
    title: "Pictures",
    items: pictures,
  },
  {
    id: "notes",
    title: "Notes",
    items: notes,
  },
  {
    id: "docs",
    title: "Docs",
    items: docs,
  },
];
---

<Layout
  title="Assets - Yangming Guo"
  description="Notes, papers, pictures, and documents from Yangming Guo."
>
  <GlassHeader client:load />
  <main class="min-h-screen">
    <section class="py-12 md:py-16">
      <div class="container max-w-3xl mx-auto px-6 md:px-4">
        <div class="mb-10">
          <a
            href="/"
            class="inline-flex items-center text-sm text-muted-foreground hover:text-purple-500 transition-colors mb-4"
          >
            Back to Portfolio
          </a>
          <h1 class="text-3xl font-bold mb-3">Assets</h1>
          <p class="text-muted-foreground max-w-2xl">
            Notes, papers, diagrams, and documents collected from the previous site.
          </p>
        </div>

        <div class="space-y-7">
          {
            sections.map((section) => (
              <section id={section.id} class="space-y-2">
                <div class="flex items-center justify-between gap-4">
                  <h2 class="section-heading font-bold">
                    {section.title}
                  </h2>
                  <span class="asset-section-count">
                    {section.items.length} items
                  </span>
                </div>

                {section.items.length === 0 ? (
                  <div class="asset-empty">
                    No items yet.
                  </div>
                ) : section.id === "files" ? (
                  <div class="asset-list">
                    {section.items.map((item) => (
                      <a
                        href={item.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="asset-list-item asset-list-item--paper"
                      >
                        <span class="asset-item-title asset-paper-title">
                          {item.title}
                        </span>
                        {item.date && (
                          <span class="asset-paper-date">
                            {item.date}
                          </span>
                        )}
                      </a>
                    ))}
                  </div>
                ) : section.id === "pictures" ? (
                  <div class="asset-list">
                    {section.items.map((item) => (
                      <a
                        href={item.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="asset-list-item asset-list-item--picture"
                      >
                        <img
                          src={item.href}
                          alt={item.title}
                          loading="lazy"
                          class="asset-picture-thumb"
                        />
                        <span class="min-w-0 flex-1">
                          <span class="asset-item-title asset-picture-title">
                            {item.title}
                          </span>
                        </span>
                      </a>
                    ))}
                  </div>
                ) : (
                  <div class="asset-list">
                    {section.items.map((item) => (
                      <a
                        href={item.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="asset-list-item"
                      >
                        <span class="min-w-0 flex-1">
                          <span class="asset-item-title">
                            {item.title}
                          </span>
                        </span>
                      </a>
                    ))}
                  </div>
                )}
              </section>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer client:load />
</Layout>

<style>
  .asset-section-count {
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--color-purple-500) 6%, transparent),
      color-mix(in oklab, var(--color-pink-500) 6%, transparent)
    );
    border: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
    border-radius: 0.375rem;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    line-height: 1;
    padding: 0.32rem 0.5rem;
    white-space: nowrap;
  }

  .asset-list {
    display: grid;
    gap: 0.4rem;
    grid-template-columns: minmax(0, 1fr);
  }

  .asset-list-item,
  .asset-empty {
    background: color-mix(in oklab, var(--background) 86%, transparent);
    border: 1px solid color-mix(in oklab, var(--border) 80%, transparent);
    border-radius: 0.5rem;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .asset-list-item {
    align-items: center;
    color: inherit;
    display: flex;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    text-decoration: none;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .asset-list-item:hover,
  .asset-list-item:focus-visible {
    background: color-mix(in oklab, var(--color-purple-500) 5%, var(--background));
    border-color: color-mix(in oklab, var(--color-purple-500) 32%, var(--border));
    box-shadow: 0 0.55rem 1.4rem color-mix(in oklab, var(--color-purple-500) 9%, transparent);
    outline: none;
    transform: translateY(-0.08rem);
  }

  .asset-list-item--picture {
    gap: 0.75rem;
  }

  .asset-list-item--paper {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .asset-picture-thumb {
    background: color-mix(in oklab, var(--background) 82%, transparent);
    border: 1px solid color-mix(in oklab, var(--border) 58%, transparent);
    border-radius: 0.25rem;
    flex-shrink: 0;
    height: 2.25rem;
    object-fit: contain;
    transition: border-color 0.2s ease;
    width: 3rem;
  }

  .asset-list-item:hover .asset-picture-thumb,
  .asset-list-item:focus-visible .asset-picture-thumb {
    border-color: color-mix(in oklab, var(--color-purple-500) 28%, var(--border));
  }

  .asset-item-title {
    color: color-mix(in oklab, var(--foreground) 76%, transparent);
    display: block;
    font-weight: 500;
    line-height: 1.45;
    overflow-wrap: anywhere;
    transition: color 0.2s ease;
  }

  .asset-list-item:hover .asset-item-title,
  .asset-list-item:focus-visible .asset-item-title {
    color: var(--color-purple-500);
  }

  .asset-paper-title,
  .asset-picture-title {
    font-family: "Times New Roman", Times, serif;
    font-size: 1rem;
  }

  .asset-paper-date {
    align-self: center;
    color: var(--muted-foreground);
    font-size: 0.78rem;
    line-height: 1;
    white-space: nowrap;
  }

  .asset-empty {
    color: var(--muted-foreground);
    padding: 0.5rem 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .asset-list-item {
      transition:
        background 0.2s ease,
        border-color 0.2s ease,
        color 0.2s ease;
    }

    .asset-list-item:hover,
    .asset-list-item:focus-visible {
      transform: none;
    }
  }
</style>
