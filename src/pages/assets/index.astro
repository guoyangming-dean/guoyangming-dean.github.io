---
import Layout from "@/layouts/Layout.astro";
import GlassHeader from "@/components/GlassHeader";
import Footer from "@/components/Footer";
import { getAssetsPageData } from "@/lib/assets";

const { files, pictures, notes, docs } = await getAssetsPageData();

const sections = [
  {
    id: "files",
    title: "Files",
    items: files,
  },
  {
    id: "pictures",
    title: "Pictures",
    items: pictures,
  },
  {
    id: "notes",
    title: "Notes",
    items: notes,
  },
  {
    id: "docs",
    title: "Docs",
    items: docs,
  },
];
---

<Layout
  title="Assets - Yangming Guo"
  description="Notes, papers, pictures, and documents from Yangming Guo."
>
  <GlassHeader client:load />
  <main class="min-h-screen">
    <section class="py-12 md:py-16">
      <div class="container max-w-3xl mx-auto px-6 md:px-4">
        <div class="mb-10">
          <a
            href="/"
            class="inline-flex items-center text-sm text-muted-foreground hover:text-purple-500 transition-colors mb-4"
          >
            Back to Portfolio
          </a>
          <h1 class="text-3xl font-bold mb-3">Assets</h1>
          <p class="text-muted-foreground max-w-2xl">
            Notes, papers, diagrams, and documents collected from the previous site.
          </p>
        </div>

        <div class="space-y-7">
          {
            sections.map((section) => (
              <section id={section.id} class="space-y-2">
                <div class="flex items-center justify-between gap-4">
                  <h2 class="section-heading font-bold">
                    {section.title}
                  </h2>
                  <span class="text-xs text-muted-foreground bg-background/60 border border-border/50 px-2 py-1 rounded-md">
                    {section.items.length} items
                  </span>
                </div>

                {section.items.length === 0 ? (
                  <div class="rounded-md border border-border/50 bg-background/80 backdrop-blur-md px-3 py-2 text-muted-foreground">
                    No items yet.
                  </div>
                ) : section.id === "pictures" ? (
                  <div class="grid grid-cols-1 gap-1.5">
                    {section.items.map((item) => (
                      <a
                        href={item.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group flex items-center gap-3 rounded-md border border-border/50 bg-background/80 backdrop-blur-md backdrop-filter dark:bg-card/30 dark:backdrop-blur-md px-3 py-2 transition-colors duration-200 hover:border-purple-500/30 hover:bg-purple-500/5"
                      >
                        <img
                          src={item.href}
                          alt={item.title}
                          loading="lazy"
                          class="h-9 w-12 shrink-0 object-contain rounded-sm bg-background/60"
                        />
                        <span class="min-w-0 flex-1">
                          <span class="block font-medium break-words text-foreground/70 group-hover:text-purple-500 transition-colors">
                            {item.title}
                          </span>
                        </span>
                      </a>
                    ))}
                  </div>
                ) : (
                  <div class="grid grid-cols-1 gap-1.5">
                    {section.items.map((item) => (
                      <a
                        href={item.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group flex items-center rounded-md border border-border/50 bg-background/80 backdrop-blur-md backdrop-filter dark:bg-card/30 dark:backdrop-blur-md px-3 py-2 transition-colors duration-200 hover:border-purple-500/30 hover:bg-purple-500/5"
                      >
                        <span class="min-w-0 flex-1">
                          <span class="block font-medium break-words text-foreground/70 group-hover:text-purple-500 transition-colors">
                            {item.title}
                          </span>
                        </span>
                      </a>
                    ))}
                  </div>
                )}
              </section>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer client:load />
</Layout>
