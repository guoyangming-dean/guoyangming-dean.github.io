---
import Layout from "@/layouts/Layout.astro";
import GlassHeader from "@/components/GlassHeader";
import HeroSection from "@/components/HeroSection";
import ExperienceSection from "@/components/ExperienceSection";
import ProjectsSection from "@/components/ProjectsSection";
import PublicationsSection from "@/components/PublicationsSection";
import EducationSection from "@/components/EducationSection";
import Footer from "@/components/Footer";
import { getPublicationsMineEntries } from "@/lib/publications-mine";

const publicationsMineEntries = await getPublicationsMineEntries();
---

<Layout>
  <GlassHeader client:load />
  <main class="min-h-screen">
    <HeroSection client:load />
    <ExperienceSection client:load />
    <ProjectsSection client:load />
    <PublicationsSection publications={publicationsMineEntries} client:load />
    <EducationSection client:load />
  </main>
  <Footer client:load />
</Layout>
